{
  "expo": {
    "name": "AI-Driven Human",
    "slug": "ai-driven-human",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ai-driven-human",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aidrivenhuman.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow AI-Driven Human to recognize speech for voice conversations with Pallavi.",
        "NSMicrophoneUsageDescription": "Allow AI-Driven Human to use the microphone for voice conversations with Pallavi."
      }
    },
    "android": {
      "package": "com.aidrivenhuman.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c1321",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4cd7f6"
        }
      ],
      "./plugins/withAuraCallConfig.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AI-Driven Human to use the microphone for voice conversations with Pallavi.",
          "speechRecognitionPermission": "Allow AI-Driven Human to recognize speech for voice conversations with Pallavi.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "llama.rn"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b148e34-39be-49b8-b621-6ed74c51802c"
      }
    },
    "owner": "dark_5133"
  }
}
